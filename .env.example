# 环境变量模板 —— 复制为 .env 并填入你自己的密钥
# Windows: copy .env.example .env
# .env 已被 .gitignore 排除，不会上传到 git；只改 .env，不要改本文件

# DeepSeek 模型密钥（必填）：首脑与所有角色专家的模型
# 获取：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-你的-deepseek-key

# Tavily 联网搜索密钥（选填，建议填）：调研专家用 web_search 工具
# 获取：https://app.tavily.com → API Keys（有免费额度）
TAVILY_API_KEY=tvly-你的-tavily-key

# 阿里云百炼（选填）：如需把模型换成 qwen 系列时使用
# 获取：https://bailian.console.aliyun.com → API-KEY
DASHSCOPE_API_KEY=sk-你的-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 专家命令执行开关（安全）：默认 0 禁用；设为 1 后编码/测试专家可真实运行 python/pytest
# 即使开启，子进程环境也会自动剔除上面所有密钥变量
HIVE_ALLOW_SHELL=0

# 架构安全验证策略文件（选填）：JSON 文件路径，对应 CLI --security-policy-file
# 只允许 fail_on_severity=critical|high（不允许放宽到低于 high）
# 示例见 scripts/security-policy.example.json
HIVE_SECURITY_POLICY_FILE=
