{
  "name": "干净架构_03",
  "architecture": {
    "overview": "统一认证、审计留痕、配额限流与失败降级一体的平台。",
    "modules": [
      {
        "name": "mask",
        "responsibility": "数据脱敏与密钥托管服务，敏感数据不落明文",
        "interfaces": [
          "mask(payload)"
        ],
        "owner_role": "编码"
      },
      {
        "name": "rate",
        "responsibility": "配额与限流控制，超预算时降级到低配模型",
        "interfaces": [
          "reserve()"
        ],
        "owner_role": "编码"
      },
      {
        "name": "api",
        "responsibility": "对外接口：完成用户身份认证与输入校验，限流保护，失败降级返回明确错误",
        "interfaces": [
          "handle(request)"
        ],
        "owner_role": "编码"
      }
    ],
    "risks": [
      "模型输出未命中 schema 时按不可信数据处理并重试"
    ]
  },
  "expect_verdict": "pass",
  "must_hit": [],
  "must_not_hit": [
    "T-SPOOF-1",
    "T-SPOOF-2",
    "T-TAMP-1",
    "T-TAMP-2",
    "T-REPU-1",
    "T-DISC-1",
    "T-DISC-2",
    "T-DOS-1",
    "T-ELEV-1",
    "T-HALL-1",
    "T-SAFE-1",
    "T-PATT-1"
  ]
}
