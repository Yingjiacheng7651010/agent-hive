{
  "name": "干净架构一（零误报）",
  "architecture": {
    "overview": "带认证、审计、限流与降级设计的系统。",
    "modules": [
      {
        "name": "api",
        "responsibility": "对外接口：完成用户身份认证与输入校验，限流保护，失败降级返回明确错误",
        "interfaces": [
          "handle(request)"
        ],
        "owner_role": "编码"
      },
      {
        "name": "store",
        "responsibility": "持久化存储，所有操作写入不可变审计日志",
        "interfaces": [
          "save(item)",
          "list()"
        ],
        "owner_role": "编码"
      }
    ],
    "risks": [
      "模型输出未命中 schema 时按不可信数据处理并重试"
    ]
  },
  "expect_verdict": "pass",
  "must_not_hit": [
    "T-SPOOF-1",
    "T-SPOOF-2",
    "T-TAMP-1",
    "T-TAMP-2",
    "T-REPU-1",
    "T-DISC-1",
    "T-DISC-2",
    "T-DOS-1",
    "T-ELEV-1",
    "T-HALL-1",
    "T-SAFE-1",
    "T-PATT-1"
  ]
}